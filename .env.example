# BEKSCITY RUN CLUB — Environment Configuration Example
# Copy this file to .env for local configuration

# Application Server Port (Render sets this automatically)
PORT=5050

# Optional: Public Domain URL (Used for production links & webhooks)
# PUBLIC_BASE_URL=https://bekscity.onrender.com

# Optional: Public Master Calendar Feed URL (.ics)
# Overrides default GitHub Pages sync feed
# PUBLIC_CALENDAR_URL=https://hayzon1.github.io/bekscity/bekscity_saturdays_Oct-Dec.ics

# Optional: Outbound SMTP Email Dispatch Configuration
# BCRC_SMTP_HOST=smtp.gmail.com
# BCRC_SMTP_PORT=587
# BCRC_SMTP_USER=club@example.com
# BCRC_SMTP_PASSWORD=your-app-password
# BCRC_SMTP_FROM=club@example.com
